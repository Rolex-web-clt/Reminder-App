# Environment Variables for Remindify SaaS

# App Port (Fixed to 3000 in AI Studio cloud environment)
PORT=3000

# MongoDB Connection String (e.g. mongodb://localhost:27017/remindify or MongoDB Atlas URI)
# If empty or not reachable, Remindify automatically falls back to an embedded JSON database
# ensuring full zero-config persistence and seamless operations out-of-the-box.
MONGO_URI=""

# JWT Secret for Auth tokens
JWT_SECRET="remindify-production-secret-jwt-key-389421"

# Gemini AI API Key (Injected automatically by AI Studio)
GEMINI_API_KEY=""

# Application Host URL
APP_URL=""

# Google Calendar Integration (Optional OAuth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email Notifications (SMTP configuration - Optional)
EMAIL_HOST="smtp.mailtrap.io"
EMAIL_PORT="2525"
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM="notifications@remindify.app"

# Cloudinary Storage for Reminder Attachments (Optional)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
